# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (Supabase / Neon / Render / Local)
DATABASE_URL=postgresql://user:password@localhost:5432/canteen_db
PG_MAX_POOL=20

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# SaaS Platform Super Admin
SUPERADMIN_EMAIL=superadmin@smartcanteen.io
SUPERADMIN_PASSWORD=SuperAdmin@2026!

# Default Canteen Admin Credentials (Tenant #1)
ADMIN_EMAIL=admin@kitcbecanteen.online
ADMIN_PASSWORD=AdminPassword123!

# Google OAuth (Optional for diner login)
GOOGLE_CLIENT_ID=

# reCAPTCHA Bot Protection (Optional / Recommended for Checkout)
RECAPTCHA_SECRET_KEY=

# Zoho Payments Gateway (Optional)
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_WEBHOOK_SECRET=

# Fast2SMS for Phone Verification (Optional)
FAST2SMS_API_KEY=

# EmailJS Configuration (Optional for Password Reset)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
